// The model is configured in globgm.toml; this file holds only Nextflow's own knobs.
params.config = "$projectDir/globgm.toml"
params.output = "$launchDir"   // the pixi task launches from <checkout>/../output/run_globgm
params.logs = "${params.output}/logs"
workDir = "${params.output}/work/nextflow"
resume = true
env.NUMBA_CACHE_DIR = "${params.output}/work/_cache/numba"

profiles {
  slurm {
    executor.jobName = { "${task.process}.${task.index}" }   // Snellius' sbatch rejects the tag's parentheses
    env.PATH = "${projectDir}/../../.pixi/envs/default/bin:\$PATH"   // batch jobs do not inherit pixi's env
    env.PRTE_MCA_prte_tmpdir_base = '/dev/shm'   // OpenMPI's shm files must be node-local; TMPDIR is GPFS
    env.PRTE_MCA_rmaps_default_mapping_policy = 'numa'   // the default packs the ranks onto one socket
    // genoa: 192 cores, 336 GB, memory tied to cores
    process {
      executor = 'slurm'
      queue = 'genoa'
      cpus = 48
      time = '1h'
      withName: 'preprocess_inputs' {
        cpus = 192   // make_fields: ~300 GB on the global extent: one per node
        time = '4h'
        clusterOptions = '--nodes=1 --ntasks=1 --exclusive --mem=0'
      }
      withName: 'mf6_input' {
        cpus = 192   // mf6ggm peaks at 187 GB: one per node
        clusterOptions = '--nodes=1 --ntasks=1 --exclusive --mem=0'
      }
      withName: 'mf6' {
        cpus = 1   // the ranks come from clusterOptions, at most 32 per node
        time = '12h'
        clusterOptions = {
          def nodes = Math.ceil(np / 32) as int
          "--nodes=${nodes} --ntasks-per-node=${Math.ceil(np / nodes) as int} --exclusive"
        }
      }
      withName: 'mf6_tree' {
        executor = 'local'   // hard links only
      }
      withName: 'post' {
        cpus = 16   // serial; the cores are for its memory
      }
    }
  }
}

report {
  enabled = true
  file = "${params.logs}/report.html"
  overwrite = true
}
timeline {
  enabled = true
  file = "${params.logs}/timeline.html"
  overwrite = true
}
trace {
  enabled = true
  file = "${params.logs}/trace.tsv"
  overwrite = true
}
dag {
  enabled = true
  file = "${params.logs}/dag.html"
  overwrite = true
}
