// The run's layout, fixed relative to this directory: globgm.toml beside the
// pipeline and nothing else; everything the run writes goes outside the
// checkout, under <checkout>/../output/<run> (params.output): the products,
// every tool's log and Nextflow's reports in logs/ (its own log and its
// .nextflow/ go there from the pixi task, which launches from that
// directory), the work tree in work/.
// The model is configured in globgm.toml; this file is only Nextflow's own
// knobs (executor, resume), the ones it needs before main.nf runs.
params.config = "$projectDir/globgm.toml"
params.output = "$projectDir/../../../output/run_globgm"
params.logs = "${params.output}/logs"
workDir = "${params.output}/work/nextflow"
resume = true

// -profile local (the default, from the pixi task) runs everything where
// Nextflow runs. -profile slurm sets each stage's executor and resources in
// its own block below: every stage but the mf6_tree merge is a job,
// mf6ggm on one node per phase, and mf6 as one job per solution: exclusive
// nodes for the ranks of that solution's nam (np), at most ranks_per_node on each (mf6 is memory-bound
// and scales weakly beyond that; upstream ran 32) and spread evenly.
profiles {
  local {
    process.executor = 'local'
  }
  slurm {
    params.ranks_per_node = 32
    // Snellius' sbatch rejects the default name: the tag's parentheses
    executor.jobName = { "${task.process}.${task.index}" }
    // a batch job does not inherit the driver's pixi environment
    env.PATH = "${projectDir}/../../.pixi/envs/default/bin:\$PATH"
    // Snellius' TMPDIR (/scratch-local) is GPFS; OpenMPI wants its
    // shared-memory backing files on a node-local filesystem
    env.PRTE_MCA_prte_tmpdir_base = '/dev/shm'
    // the default packs the ranks onto the first cores of one socket
    env.PRTE_MCA_rmaps_default_mapping_policy = 'numa'
    // One block per stage, edit freely: executor 'slurm' submits the stage
    // as a job, 'local' runs it where Nextflow runs. Snellius ties memory to
    // cores (genoa: 192 cores, 336 GB, so 1.75 GB per core).
    process {
      withName: 'preprocess_inputs' {
        executor = 'slurm'
        queue = 'genoa'
        cpus = 48
        time = '1h'
      }
      withName: 'map_glob' {
        executor = 'slurm'
        queue = 'genoa'
        cpus = 48
        time = '1h'
      }
      // a whole node for its memory: OOM-killed in 84 GB at global extent
      withName: 'fields' {
        executor = 'slurm'
        queue = 'genoa'
        cpus = 192
        time = '1h'
      }
      // mf6ggm, one whole genoa node each so the three run side by side.
      // Global, measured 2026-09-17: peak RSS 187 GB (ss), 160 GB (tr, one
      // month), so two never fit in a node's 336 GB; 77 s on all 192 cores
      // against 180-210 s on 24 to 96 (design.md, Known traps). OpenMP takes
      // every core of the job's cpuset, so no OMP_NUM_THREADS.
      withName: 'mf6_input_.*' {
        executor = 'slurm'
        queue = 'genoa'
        cpus = 192
        time = '1h'
        clusterOptions = '--nodes=1 --ntasks=1 --exclusive --mem=0'
      }
      // the ranks come from clusterOptions; cpus > 1 would add --cpus-per-task
      withName: 'mf6_(ss|spu|tr)' {
        executor = 'slurm'
        queue = 'genoa'
        cpus = 1
        time = '12h'
        clusterOptions = {
          def nodes = Math.ceil(np / params.ranks_per_node) as int
          def per_node = Math.ceil(np / nodes) as int
          "--nodes=${nodes} --ntasks-per-node=${per_node} --exclusive"
        }
      }
      // hard links only, seconds of work: not worth a queue wait
      withName: 'mf6_tree_.*' {
        executor = 'local'
      }
      // mf6ggmpost is serial, one job per (solution, output); the cores are
      // for their memory. Global, measured 2026-10-13: peak RSS 9.2 GB, about
      // 9 min for the largest solution's 12 months.
      withName: 'post_.*' {
        executor = 'slurm'
        queue = 'genoa'
        cpus = 16
        time = '1h'
      }
    }
  }
}

// Performance reports beside nextflow.log; overwrite so a rerun does not
// stop on the previous run's files. Cached tasks appear in the trace as
// CACHED with no timings.
report.enabled = true
report.file = "${params.logs}/report.html"
report.overwrite = true
timeline.enabled = true
timeline.file = "${params.logs}/timeline.html"
timeline.overwrite = true
trace.enabled = true
trace.file = "${params.logs}/trace.tsv"
trace.overwrite = true
trace.fields = 'task_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,workdir'
dag.enabled = true
dag.file = "${params.logs}/dag.html"
dag.overwrite = true
